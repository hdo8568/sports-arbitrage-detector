# Copy this file to .env and fill in your own values. Never commit .env.

# The Odds API key (https://the-odds-api.com)
ODDS_API_KEY=your-odds-api-key-here

# Gmail account that sends the arbitrage alerts (use a Gmail app password)
EMAIL_USER=alerts@example.com
EMAIL_PASS=your-gmail-app-password
EMAIL_TO=you@example.com

# Optional: total dollars to split across both sides in the alert stake suggestions
ARB_TOTAL_STAKE=100

# Optional: path to the SQLite database the API reads (defaults to odds_data.db in this folder)
# ODDS_DB_PATH=/home/ec2-user/sports-arbitrage-detector/odds_data.db

# Boost Desk: the sportsbooks you can bet at, as The Odds API keys or names (any case).
# Hedges are only looked for at these books.
BOOKS=draftkings,fanduel,betmgm,caesars,williamhill_us,espnbet,fanatics,betrivers

# Optional: regions Boost Desk asks The Odds API for. eu is where Pinnacle is.
# Each region costs one API credit per market, so trim this to save credits.
# ODDS_REGIONS=us,us2,uk,eu,au

# Optional: where Boost Desk keeps its promo log (defaults to boosts.db in this folder)
# BOOSTS_DB_PATH=/home/ec2-user/sports-arbitrage-detector/boosts.db
